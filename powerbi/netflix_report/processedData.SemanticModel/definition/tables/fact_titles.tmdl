table fact_titles
	lineageTag: 54794b30-f6cc-40ca-b5fa-db96c697eeac

	measure 'Total Titles' = ```
			
			    DISTINCTCOUNT(fact_titles[title_id])
			```
		formatString: 0
		lineageTag: 82fbc971-8ca4-4ea5-bdfa-6d725b2f4e6a

	measure 'Avg IMDb Score' = ```
			
			    AVERAGE(fact_titles[imdb_score])
			```
		lineageTag: ba370332-7435-4cb8-85bb-e3f8b048aab0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Catalog Avg IMDb' = ```
			
			    CALCULATE([Avg IMDb Score], ALL(fact_titles))
			```
		lineageTag: b8c2d3e4-f5a6-7890-1234-567890abcdef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg IMDb Score (n>=10)' = ```
			
			    IF([Total Titles] >= 10, [Avg IMDb Score])
			```
		lineageTag: c1d2e3f4-a5b6-7890-1234-567890abcdef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median IMDb Score' = ```
			
			    MEDIAN(fact_titles[imdb_score])
			```
		lineageTag: 16f7a2e3-48b6-4b33-9548-8f0b712b1070

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% High-Rated Titles' = ```
			
			    VAR HighRatedCount =
			        CALCULATE([Total Titles], fact_titles[imdb_score] >= 7.0)
			    VAR OverallTitles = [Total Titles]
			    RETURN
			        DIVIDE(HighRatedCount, OverallTitles, 0)
			```
		lineageTag: 0f17769f-4d99-460e-951d-5ac8845d5999

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Low-Rated Titles' = ```
			
			    VAR LowRatedCount =
			        CALCULATE([Total Titles], fact_titles[imdb_score] < 5.5)
			    VAR OverallTitles = [Total Titles]
			    RETURN
			        DIVIDE(LowRatedCount, OverallTitles, 0)
			```
		lineageTag: 0498b4bf-f431-42a1-867c-8a1618e8bc58

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Runtime' = ```
			
			    AVERAGE(fact_titles[runtime])
			```
		lineageTag: eb2bb737-e6bb-4641-a053-be7fdaacc6ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mature Period Titles' = ```
			
			    CALCULATE([Total Titles], dim_date[is_full_year] = 1)
			```
		formatString: 0
		lineageTag: 4586055e-a2d8-413c-ab8a-8baa58d0df92

	measure 'Titles YoY Growth %' = ```
			
			    VAR CurrentYear = SELECTEDVALUE(dim_date[year])
			    VAR IsCurrentFull = SELECTEDVALUE(dim_date[is_full_year])
			    VAR CurrentReleases = [Total Titles]
			    VAR PriorYearReleases =
			        CALCULATE(
			            [Total Titles],
			            FILTER(
			                ALL(dim_date),
			                dim_date[year] = CurrentYear - 1
			                    && dim_date[is_full_year] = 1
			            )
			        )
			    RETURN
			        IF(
			            IsCurrentFull = 1 && NOT ISBLANK(PriorYearReleases) && PriorYearReleases > 0,
			            DIVIDE(CurrentReleases - PriorYearReleases, PriorYearReleases, BLANK()),
			            BLANK()
			        )
			```
		lineageTag: 39efab54-a9a2-47f8-8c0a-6ae901c03562

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Genre Share %' = ```
			
			    VAR MaxGenreTitles =
			        MAXX(VALUES(fact_titles[genre_group]), [Total Titles])
			    VAR AllTitles =
			        CALCULATE([Total Titles], ALLSELECTED(fact_titles[genre_group]))
			    RETURN
			        DIVIDE(MaxGenreTitles, AllTitles, 0)
			```
		lineageTag: 829d06a9-b2fc-452f-ba37-296af6998980

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Language Diversity Count' = ```
			
			    DISTINCTCOUNT(fact_titles[primary_language])
			```
		formatString: 0
		lineageTag: e44b0ba4-c763-4175-810a-c1a662b69e35

	measure 'Titles in Low-Sample Groups' = ```
			
			    VAR CurrentGroupSize = [Total Titles]
			    RETURN
			        IF(CurrentGroupSize < 10, CurrentGroupSize, 0)
			```
		formatString: 0
		lineageTag: 8a184d81-9c9b-4413-90a5-67c3965ffffa

	measure 'Sample Reliability Badge' = ```
			
			    VAR TitleCount = [Total Titles]
			    RETURN
			        IF(
			            TitleCount < 10,
			            "⚠️ Low Sample (n < 10) - Interpret with Caution",
			            "✅ Robust Sample (n >= 10)"
			        )
			```
		lineageTag: ed1dd855-546b-437a-a8b9-a47daf1055f2

