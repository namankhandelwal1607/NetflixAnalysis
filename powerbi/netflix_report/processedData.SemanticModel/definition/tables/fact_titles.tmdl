	column runtime_outlier = ```
			
			    SWITCH(
			        TRUE(),
			        fact_titles[runtime] < 53, "Short Runtime",
			        fact_titles[runtime] > 141, "Epic Runtime",
			        "None"
			    )
			```
		dataType: string
		lineageTag: 8a9b0c1d-2e3f-4a5b-6c7d-8e9f0a1b2c3d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column score_outlier = ```
			
			    SWITCH(
			        TRUE(),
			        fact_titles[imdb_score] < 3.75, "Low Score",
			        fact_titles[imdb_score] > 8.95, "High Score",
			        "None"
			    )
			```
		dataType: string
		lineageTag: 9b0c1d2e-3f4a-5b6c-7d8e-9f0a1b2c3d4e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column is_outlier = ```
			
			    IF(
			        fact_titles[runtime_outlier] <> "None" || fact_titles[score_outlier] <> "None",
			        1,
			        0
			    )
			```
		dataType: int64
		formatString: 0
		lineageTag: a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column outlier_type = ```
			
			    SWITCH(
			        TRUE(),
			        fact_titles[runtime] < 53, "Short Runtime",
			        fact_titles[runtime] > 141, "Epic Runtime",
			        fact_titles[imdb_score] < 3.75, "Low Score",
			        fact_titles[imdb_score] > 8.95, "High Score",
