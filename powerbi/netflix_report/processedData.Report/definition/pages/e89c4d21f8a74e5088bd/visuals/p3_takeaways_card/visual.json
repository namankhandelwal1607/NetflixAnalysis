                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Documentary Dominance",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt",
                      "color": "#4CAF50"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Highest catalog quality by a wide margin (mean IMDb 6.93, 55.8% rated >= 7.0 across 163 titles). Generates consistent global acclaim across multiple languages.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#CCCCCC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Comedy & Thriller Quality Gap",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt",
                      "color": "#E50914"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Lowest perceived quality tiers: Comedy (mean 5.75, 5.6% >= 7.0) and Thriller/Crime/Horror (mean 5.74, 9.4% >= 7.0). High volume (175 combined titles) but high acclaim is exceptionally rare.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#CCCCCC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Extreme Language Concentration",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt",
                      "color": "#FFA000"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "English accounts for 71.8% of all releases (419 titles). Top non-English languages (Spanish 5.8%, Hindi 5.6%, French 3.4%) have small sample sizes per genre, creating high score volatility.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#CCCCCC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "* Note: In the adjacent matrix, cells with n < 10 titles have low confidence due to sample variance.",
